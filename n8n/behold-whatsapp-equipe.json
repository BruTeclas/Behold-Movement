    {
      "parameters": {
        "jsCode": "// Os nós do Chatwoot não repassam o arquivo: junta de novo o que chegou ao subfluxo.\nconst entrada = $('Dados do envio').first();\nreturn [{ json: { ...$input.first().json, tem_arquivo: !!(entrada.binary && entrada.binary.data) }, binary: entrada.binary || {} }];"
      },
