      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Reaproveita a conversa ainda aberta do contato na caixa do Behold; sem ela, o fluxo cria uma nova.\nconst m = $('Dados do envio').first().json;\nconst contato = $('Escolher contato').first().json;\n// O nó anterior devolve um item por conversa (ou um item vazio, se não houver nenhuma).\nconst lista = $input.all().map((i) => i.json).filter((c) => c && c.id);\nconst aberta = lista\n  .filter((c) => String(c.inbox_id) === String(m.chatwoot_inbox_id) && c.status !== 'resolved')\n  .sort((a, b) => (b.last_activity_at || 0) - (a.last_activity_at || 0))[0];\nreturn [{ json: { contact_id: contato.contact_id, id: aberta ? aberta.id : null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -120
      ],
      "id": "0527aebb-6056-590a-9f25-dec87b465722",
      "name": "Escolher conversa"
    },
