        "inputSource": "passthrough"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        -460,
        0
      ],
      "id": "2febb225-1d93-57f2-91df-1de54ddbfe39",
      "name": "Dados do envio"
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "search",
        "accountId": {
          "__rl": true,
          "value": "={{ $('Dados do envio').first().json.chatwoot_account_id }}",
          "mode": "id"
        },
        "searchQuery": "={{ $('Dados do envio').first().json.telefone_e164.replace('+', '') }}"
      },
      "type": "@fazer-ai/n8n-nodes-chatwoot.chatwoot",
      "typeVersion": 1,
      "position": [
        -240,
        0
      ],
      "id": "769a331c-05a6-5420-a666-66f777c04fb6",
      "name": "Chatwoot: buscar contato",
      "onError": "continueRegularOutput",
      "credentials": {
        "fazerAiChatwootApi": {
          "id": "",
          "name": "Chatwoot fazer.ai · Behold"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Procura, no resultado da busca do Chatwoot, o contato com o mesmo telefone.\nconst m = $('Dados do envio').first().json;\nconst r = $input.first().json;\nconst lista = Array.isArray(r.payload) ? r.payload : [];\nconst digitos = (s) => String(s || '').replace(/\\D/g, '');\nconst achado = lista.find((c) => digitos(c.phone_number) === digitos(m.telefone_e164));\nreturn [{ json: { contact_id: achado ? achado.id : null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ],
      "id": "aa31e6fa-3093-54ee-8fa6-278e1e3e14a3",
      "name": "Escolher contato"
    },
